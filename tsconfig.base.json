{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@lectrai/source"],
    "baseUrl": ".",
    "paths": {
      "@lectrai/db": ["packages/db/src/index.ts"],
      "@lectrai/shared-types": ["packages/shared-types/src/index.ts"],
      "@lectrai/shared-utils": ["packages/shared-utils/src/index.ts"]
    }
  }
}
