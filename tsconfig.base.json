{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@park-u/source"],
    "baseUrl": ".",
    "paths": {
      "@park-u/db": ["packages/db/src/index.ts"],
      "@park-u/shared-types": ["packages/shared-types/src/index.ts"],
      "@park-u/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@park-u/vision-protocol": ["packages/vision-protocol/src/index.ts"]
    }
  }
}
