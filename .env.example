# Supabase project URL for API/admin access.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase keys.
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mobile app backend base URL.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional verification redirect URL used in sign-up emails.
# SUPABASE_AUTH_EMAIL_REDIRECT_TO=lectrai://auth/callback

# Optional API rate limiting. Defaults are 15 minutes / 200 requests for general API,
# and 15 minutes / 20 requests for auth endpoints.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=200
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Required for backend lecture transcription processing.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# OPENAI_TRANSCRIPT_PROCESSING_MODEL=gpt-4o-2024-08-06
# OPENAI_TRANSCRIPT_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIPT_EMBEDDING_DIMENSIONS=1536
# OPENAI_TRANSCRIPT_EMBEDDING_BATCH_SIZE=64

# Direct Postgres connection string for backend services and migrations.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Optional aliases if you prefer provider-specific names.
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# POSTGRES_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Optional SSL override. Defaults to require.
# PGSSLMODE=require
