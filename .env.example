# Server-side Firebase/Firestore credentials.
# Keep real values in .env (local) or CI/CD secret manager.

# Option A: single JSON secret
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: file path (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/service_account.json

# Option C: split values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

FIRESTORE_DATABASE_ID=park-u-dev