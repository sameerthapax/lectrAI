# Firestore database ID (optional). Defaults to "(default)" when omitted.
FIRESTORE_DATABASE_ID=park-u-dev

# Optional for better diagnostics in local scripts.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional ADC key-file path for local/service environments.
# Prefer attached IAM identity on Cloud Run in production.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
