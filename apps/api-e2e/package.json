{
  "name": "@lectrai/api-e2e",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "axios": "^1.6.0"
  },
  "nx": {
    "implicitDependencies": [
      "api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "api:build",
          "api:serve"
        ]
      }
    }
  }
}
