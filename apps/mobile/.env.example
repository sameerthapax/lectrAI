# Expo public environment variables for the mobile app.
# Copy this file to apps/mobile/.env.local for local development.

# Base URL for backend API requests from the Expo app.
# Use your machine's reachable address for a device, not localhost.
# Simulator example:
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Device example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000/api
